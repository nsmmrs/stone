namespace files

struct ConflictError
    reason ConflictReason

union ConflictPolicy
    "The action to take when a file path conflict exists."
    overwrite
        "On a conflict, the target is overridden."
    add
        "On a conflict, the upload is rejected. You can call Upload endpoint again and attempt a different path."
    update UpdateParentRev
        "On a conflict, only overwrite the target if the parent_rev matches."
    other*

union ConflictReason
    folder
        "Conflict with a folder."
    file
        "Conflict with a file."
    autorename_failed
        "Could not autorename."
    other*

union DownloadError
    disallowed SubError
    no_file SubError
    other*

struct FileInfo
    name String
        "Name of file."

struct FileTarget
    path String
        "Path from root. Should be an empty string for root."
    rev Nullable
        "Revision of target file."

struct IncorrectOffsetError
    correct_offset UInt64

struct SubError
    reason String
        "A code indicating the type of error."

struct UpdateParentRev
    parent_rev String

struct UploadAppend
    upload_id String
        "Identifies the upload session to append data to."
    offset UInt64
        "The offset into the file of the current chunk of data being uploaded. It can also be thought of as the amount of data that has been uploaded so far. We use the offset as a sanity check."

union UploadAppendError
    not_found
        "The upload_id was not found."
    closed
        "Upload session was closed."
    incorrect_offset IncorrectOffsetError
    other*

struct UploadCommit
    path String
        "Path in the user's Dropbox to save the file."
    mode ConflictPolicy
        "The course of action to take if a file already exists at the given path."
    append_to Nullable
        "If specified, the current chunk of data should be appended to an existing upload session."
    autorename Boolean = False
        "Whether the file should be autorenamed in the event of a conflict."
    client_modified_utc Nullable
        "Self reported time of when this file was created or modified."
    mute Boolean = False
        "Whether the devices that the user has linked should notify them of the new or updated file."

union UploadCommitError
    conflict ConflictError
    no_write_permission
        "User does not have permission to write in the folder. An example of this is if the folder is a read-only shared folder."
    insufficient_quota
        "User does not have sufficient space quota to save the file."
    other*

struct UploadSessionStart
    upload_id String
        "A unique identifier for the upload session."

route Download (FileTarget, FileInfo, DownloadError)
    "Download a file in a user's Dropbox."

route Upload (UploadCommit, FileInfo, UploadCommitError)
    "Use this endpoint to either finish an ongoing upload session that was begun with UploadStart or upload a file in one shot."

route UploadAppend/upload/append (UploadAppend, Void, Void)
    "Start an upload session."

route UploadStart/upload/start (Void, UploadSessionStart, Void)
    "Start an upload session."
